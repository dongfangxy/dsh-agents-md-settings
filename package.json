{
  "name": "@local/agents-md-settings",
  "version": "1.0.2",
  "private": true,
  "description": "DeepSeek Harness bundle: open ~/.dsh/AGENTS.md from Settings -> General.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agents.md"
  ],
  "author": "Chengxi Zhang (https://github.com/dongfangxy)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongfangxy/dsh-agents-md-settings.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
